# syntax=docker/dockerfile:1

FROM node:22-bookworm-slim

WORKDIR /app
ENV NODE_ENV=production \
    CAREOS_HOST=0.0.0.0 \
    CAREOS_PORT=3847

RUN apt-get update \
  && apt-get install -y --no-install-recommends curl ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && groupadd --system careops \
  && useradd --system --gid careops --create-home careops

COPY package.json package-lock.json ./
RUN npm ci --omit=dev \
  && chown -R careops:careops /app

COPY --chown=careops:careops tsconfig.json ./
COPY --chown=careops:careops src ./src
COPY --chown=careops:careops scripts ./scripts
COPY --chown=careops:careops docs ./docs
COPY --chown=careops:careops samples ./samples
COPY --chown=careops:careops web ./web
COPY --chown=careops:careops data/.gitkeep ./data/
COPY --chown=careops:careops docker/entrypoint-careos.sh /entrypoint-careos.sh
RUN chmod +x /entrypoint-careos.sh

USER careops
EXPOSE 3847
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=5 \
  CMD curl -fsS "http://127.0.0.1:${CAREOS_PORT:-3847}/health" || exit 1

ENTRYPOINT ["/entrypoint-careos.sh"]
