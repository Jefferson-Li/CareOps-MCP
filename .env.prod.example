# Production environment — copy to .env.prod and set strong secrets.
# NEVER commit .env.prod
#
# docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up --build -d

IMAGE_TAG=prod

# Bind to loopback by default; put a reverse proxy in front for public access.
CAREOS_HOST_PORT=127.0.0.1:3847
OCR_HOST_PORT=127.0.0.1:3850

# Seed only on first empty volume; keep 0 for normal restarts.
CAREOS_SEED_ON_START=0

OCR_MODE=auto

# Required: set the same value for both when enabling the MCP token gate.
CAREOPS_MCP_TOKEN=replace-with-long-random-secret
MCP_AUTH_TOKEN=replace-with-long-random-secret
MCP_ACTOR=prod
