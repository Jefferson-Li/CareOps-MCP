# syntax=docker/dockerfile:1
# Unit-test image only. Node and Python come from official images.
# This build does not run apt, so it does not use Debian mirrors.
FROM node:22-bookworm-slim AS node

FROM python:3.12-slim-bookworm

COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -sf ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
  && ln -sf ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

RUN python3 -m venv /opt/venv \
  && /opt/venv/bin/pip install --no-cache-dir -r workers/ocr/requirements-dev.txt

ENV PATH="/opt/venv/bin:${PATH}" \
    PYTHONDONTWRITEBYTECODE=1 \
    CAREOS_DATA_DIR=/tmp/careos-test-data

# Keep the host coverage directory writable by the user who ran `make test`.
CMD ["sh", "scripts/docker-test-entry.sh"]
