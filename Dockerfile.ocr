# syntax=docker/dockerfile:1

FROM python:3.12-slim-bookworm

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    OCR_HOST=0.0.0.0 \
    OCR_PORT=3850 \
    OCR_MODE=auto

# The official Python image already has CA certificates. Tesseract is not in
# that image, so install it over HTTPS. Signatures stay enforced.
RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
  && apt-get update -o Acquire::Retries=3 \
  && apt-get install -y -o Acquire::Retries=3 --no-install-recommends \
       tesseract-ocr \
       tesseract-ocr-eng \
  && rm -rf /var/lib/apt/lists/* \
  && groupadd --system careops \
  && useradd --system --gid careops --create-home careops

COPY workers/ocr/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt pytesseract \
  && rm /tmp/requirements.txt

COPY --chown=careops:careops workers/ocr ./workers/ocr
COPY --chown=careops:careops samples ./samples

USER careops
EXPOSE 3850
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=5 \
  CMD python -c "import os,sys,urllib.request; u='http://127.0.0.1:%s/health'%os.environ.get('OCR_PORT','3850'); sys.exit(0 if urllib.request.urlopen(u, timeout=4).status==200 else 1)"

CMD ["python", "workers/ocr/app.py"]
