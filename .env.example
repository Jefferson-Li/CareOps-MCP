# Local / shared defaults for docker compose (safe to copy; no real secrets).
# Copy to .env if you want custom host ports:  cp .env.example .env
#
# If 3847/3850 are already in use (local npm run careos / ocr), remap host ports:
#   CAREOS_HOST_PORT=13847
#   OCR_HOST_PORT=13850

CAREOS_HOST_PORT=3847
OCR_HOST_PORT=3850

# Optional MCP token gate (leave empty for local demo without auth)
CAREOPS_MCP_TOKEN=
MCP_AUTH_TOKEN=
MCP_ACTOR=cursor
